# WorkPilot AI — multi-user server image
# Build from the repo root:  docker build -f deploy/Dockerfile.server .
#
# The base is pinned by digest (Dependabot's docker ecosystem moves it), the
# Python dependencies by apps/backend/requirements.lock (exact versions and
# hashes), and CI builds this image and migrates a database with it on every
# pull request (ci.yml, server-image).
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704

RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# The GitHub CLI, which the AI review of a server project's pull requests
# runs (runners/github, as a job on the clone, with the GitHub token of whoever
# started it). A release pinned by version and by the SHA-256 GitHub publishes
# for it, for the image's architecture; any other architecture stops the build.
RUN set -eu; \
    version=2.83.0; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) sum=a5cf6cdb40fc67751adf561126b3314044779cea81ba4f254fbe8e9a69f1676f ;; \
      arm64) sum=12311e320d4cfdb54d7fa2d58cd1e3a2ccb4c12e1c3abb32b0a2e48bd0f991bf ;; \
      *) echo "No pinned GitHub CLI for $arch" >&2; exit 1 ;; \
    esac; \
    name="gh_${version}_linux_${arch}"; \
    curl -fsSL -o "/tmp/$name.tar.gz" \
      "https://github.com/cli/cli/releases/download/v${version}/$name.tar.gz"; \
    echo "$sum  /tmp/$name.tar.gz" | sha256sum -c -; \
    tar -xzf "/tmp/$name.tar.gz" -C /tmp "$name/bin/gh"; \
    install -m 0755 "/tmp/$name/bin/gh" /usr/local/bin/gh; \
    rm -rf "/tmp/$name.tar.gz" "/tmp/$name"; \
    gh --version

# The server clones and builds other people's repositories: it does not need
# root for that, and should not have it.
RUN useradd --create-home --uid 10001 workpilot \
    && mkdir -p /data/repos /app/data \
    && chown workpilot:workpilot /data/repos /app/data

WORKDIR /app

# Outside /app/apps/backend: a COPY into it would create that directory as
# root, and the server user could not write beside its code (below).
COPY apps/backend/requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock \
    && rm /tmp/requirements.lock

# Owned by the server user: the backend writes beside its code at runtime
# (websocket_server.log, the SQLite fallback, caches), and a read-only tree
# would stop it at startup.
COPY --chown=workpilot:workpilot apps/backend /app/apps/backend
# Read from the repository root by the backend (`Path(__file__).parents[3]`):
# the provider registry, the declarative workflows, the harness catalogue,
# the skills and their emitted output, and SOUL.md.
COPY config /app/config
COPY workflows /app/workflows
COPY capabilities /app/capabilities
COPY skills /app/skills
COPY .agents /app/.agents
COPY SOUL.md /app/SOUL.md
COPY --chmod=755 deploy/server-entrypoint.sh /usr/local/bin/workpilot-server

USER workpilot
WORKDIR /app/apps/backend

# Git identity for server-side merges/commits (override via env)
RUN git config --global user.name "WorkPilot Server" \
    && git config --global user.email "workpilot@localhost"

EXPOSE 9000 8765

CMD ["workpilot-server"]
