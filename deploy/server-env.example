# WorkPilot AI server-mode secrets — copy to .env.server (next to
# docker-compose.yml) and fill in.

# PostgreSQL password (used by both services)
POSTGRES_PASSWORD=

# JWT signing secret (>= 32 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WORKPILOT_JWT_SECRET=

# Fernet master key encrypting per-user integration secrets:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WORKPILOT_SECRETS_MASTER_KEY=

# Microsoft Entra ID SSO (leave empty to disable; local accounts always work)
# App registration type: "Mobile and desktop applications",
# redirect URI: http://localhost (loopback, any port)
WORKPILOT_ENTRA_TENANT_ID=
WORKPILOT_ENTRA_CLIENT_ID=

# Server-level LLM credentials (shared pool for all agent runs)
CLAUDE_CODE_OAUTH_TOKEN=

# Tuning
WORKPILOT_MAX_CONCURRENT_RUNS=3
WORKPILOT_ACCESS_TOKEN_TTL_MINUTES=15
WORKPILOT_REFRESH_TOKEN_TTL_DAYS=14
