# Force LF line endings for all text files
* text=auto eol=lf

# Specific file types
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Vendored third-party trees are stored byte-for-byte: `scripts/vendor_bmad.py
# --check` re-downloads the pinned release and compares files, so a line ending
# git normalised on checkout would report as drift on every machine.
skills/bmad/** -text
