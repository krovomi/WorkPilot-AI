# Force LF line endings for all text files
* text=auto eol=lf

# Specific file types
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
# Applied byte for byte by `git am`: never normalised.
scripts/wiki/patches/*.patch -text
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Vendored third-party trees are stored byte-for-byte: `scripts/vendor_bmad.py
# --check` re-downloads the pinned release and compares files, so a line ending
# git normalised on checkout would report as drift on every machine.
skills/bmad/** -text
graphify-out/graph.json merge=graphify

# Generated by `python scripts/skills_cli.py build` (the only writer, see
# docs/architecture/skills.md) for the default harnesses of
# capabilities/harnesses.yaml: collapsed in pull request diffs. Edit the source
# (skills/, apps/backend/agents/subagents/) and rebuild instead. skills-lock.json
# is written by the same build but stays expanded on purpose: its diff is how a
# pack version or content-hash change shows up in review.
.agents/skills/** linguist-generated=true
.agents/agents/** linguist-generated=true
.gemini/commands/** linguist-generated=true
.claude-plugin/marketplace.json linguist-generated=true

# A bundled resource travels with its skill as a byte copy (`plan.copies` in
# skills_registry/build.py), so it is stored exactly as its source holds it.
# Otherwise a vendored tree kept byte-for-byte above (`skills/bmad/** -text`)
# ships a CRLF asset whose emitted copy alone git normalises, and `skills:check`
# reports that file as stale on every machine, for ever: rebuilding cannot
# settle it, because the next checkout normalises the copy again.
.agents/skills/** -text
# The SKILL.md is re-rendered rather than copied, and Python writes it with the
# platform's line ending, so it stays normalised: a build run on Windows must
# not commit CRLF documents. Same for the agent files and the Gemini commands,
# which are rendered the same way and keep the default above.
.agents/skills/*/SKILL.md text eol=lf
