{
	"name": "workpilot-ai-mobile",
	"version": "1.3.3",
	"main": "expo-router/entry",
	"dependencies": {
		"@expo/metro-runtime": "~58.0.16",
		"expo": "~58.0.22",
		"expo-auth-session": "~58.0.16",
		"expo-constants": "~58.0.14",
		"expo-crypto": "~58.0.7",
		"expo-device": "~58.0.5",
		"expo-image-picker": "~58.0.10",
		"expo-linking": "~58.0.15",
		"expo-localization": "~58.0.5",
		"expo-notifications": "~58.1.7",
		"expo-router": "~58.0.29",
		"expo-secure-store": "~58.0.2",
		"expo-sharing": "~58.0.21",
		"expo-status-bar": "~58.0.4",
		"expo-web-browser": "~58.0.7",
		"i18next": "^26.6.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-i18next": "^17.1.10",
		"react-native": "0.88.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.1",
		"react-native-web": "~0.21.4"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@testing-library/react-native": "^14.1.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.20.5",
		"@types/react": "~19.3.0",
		"jest": "^30.5.2",
		"jest-expo": "~58.0.13",
		"typescript": "~6.0.3"
	},
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
		"doctor": "expo-doctor",
		"export:web": "expo export --platform web",
		"test:e2e:server": "playwright test --config=e2e/playwright.config.ts"
	},
	"private": true,
	"description": "iOS and Android app for WorkPilot AI server mode",
	"license": "AGPL-3.0",
	"jest": {
		"preset": "jest-expo",
		"setupFiles": [
			"./jest.setup.js"
		],
		"testPathIgnorePatterns": [
			"/node_modules/",
			"/dist/",
			"/e2e/"
		],
		"collectCoverageFrom": [
			"src/**/*.{ts,tsx}",
			"!src/**/*.d.ts"
		]
	},
	"packageManager": "pnpm@12.16.1"
}
