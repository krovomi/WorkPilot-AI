#!/bin/sh

# Pre-commit gate — rapide et LIMITÉ AUX FICHIERS STAGÉS.
#
# Règles de conception (apprises à la dure) :
#   1. Ne toucher QUE les fichiers réellement stagés. Formater tout le dépôt
#      réécrit des centaines de fichiers sans rapport et laisse un working tree
#      sale après chaque commit.
#   2. Pas de typecheck complet ici : `tsc --noEmit` parcourt tout le frontend
#      et peut prendre plusieurs minutes (surtout sous Windows). Il tourne au
#      pre-push (avec timeout) et en CI.
#   3. Un outil manquant AVERTIT, il ne bloque pas. La CI reste le vrai garde-fou.
#   4. Un secret trouvé BLOQUE, sur tout fichier indexé, quel que soit son type :
#      ce n'est pas un lint, et la CI ne le cherche pas.
#
# Bypass : git commit --no-verify          (saute tous les hooks)
#          PRE_COMMIT_SKIP_TESTS=1 ...     (garde le lint, saute les tests)

set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# --- Secrets : scan_secrets.py sur l'index ------------------------------------
# Le scanner lit les fichiers dans l'index, donc ce que le commit contiendra.
# Lancé après le re-stage (qui peut y ajouter des lignes du working tree), et
# avant la sortie « rien à linter » : un .env ou un .yaml seul se scanne aussi.
# Python : celui du venv, aux mêmes endroits que findVenvBin
# (scripts/lib/test-selection.js), sinon celui du PATH.
PYTHON=""
for candidate in \
  apps/backend/.venv/bin/python apps/backend/.venv/Scripts/python.exe \
  .venv/bin/python .venv/Scripts/python.exe \
  .cache/.venv/bin/python .cache/.venv/Scripts/python.exe \
  python3 python; do
  if "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 10))' >/dev/null 2>&1; then
    PYTHON="$candidate"
    break
  fi
done

scan_secrets() {
  if [ -z "$PYTHON" ]; then
    echo "⚠  Python 3.10+ introuvable — scan des secrets sauté. Relire git diff --cached avant de committer." >&2
    return 0
  fi
  if "$PYTHON" apps/backend/security/scan_secrets.py --staged-only --quiet; then
    return 0
  fi
  echo "✖  [pre-commit] Commit bloqué : secret potentiel dans les fichiers indexés (détail ci-dessus)." >&2
  echo "   Sortir la valeur du fichier (.env-files/*.env, variable d'environnement), puis git add." >&2
  echo "   Faux positif : « # pragma: allowlist secret » en fin de ligne, ou une regex dans .secretsignore." >&2
  exit 1
}

py_staged=$(printf '%s\n' "$staged" | grep -E '^apps/backend/.*\.py$' || true)
fe_staged=$(printf '%s\n' "$staged" | grep -E '^apps/frontend/.*\.(ts|tsx|js|jsx|cjs|mjs|json|jsonc|css)$' || true)

if [ -z "$py_staged" ] && [ -z "$fe_staged" ]; then
  scan_secrets
  echo "[pre-commit] Aucun source Python/frontend stagé — rien à linter."
  exit 0
fi

# --- Backend : ruff sur les fichiers .py stagés uniquement -------------------
if [ -n "$py_staged" ]; then
  if python -m ruff --version >/dev/null 2>&1; then
    RUFF="python -m ruff"
  elif command -v ruff >/dev/null 2>&1; then
    RUFF="ruff"
  elif [ -x ".venv/Scripts/ruff.exe" ]; then
    RUFF=".venv/Scripts/ruff.exe"
  elif [ -x ".venv/bin/ruff" ]; then
    RUFF=".venv/bin/ruff"
  elif [ -x "apps/backend/.venv/Scripts/ruff.exe" ]; then
    RUFF="apps/backend/.venv/Scripts/ruff.exe"
  elif [ -x "apps/backend/.venv/bin/ruff" ]; then
    RUFF="apps/backend/.venv/bin/ruff"
  else
    RUFF=""
    echo "⚠  ruff introuvable — lint backend sauté (pip install ruff). La CI le vérifiera." >&2
  fi

  if [ -n "$RUFF" ]; then
    echo "[pre-commit] ruff format + check --fix (fichiers stagés)…"
    printf '%s\n' "$py_staged" | tr '\n' '\0' | xargs -0 $RUFF format
    printf '%s\n' "$py_staged" | tr '\n' '\0' | xargs -0 $RUFF check --fix
  fi
fi

# --- Frontend : biome sur les fichiers stagés uniquement ---------------------
if [ -n "$fe_staged" ]; then
  fe_rel=$(printf '%s\n' "$fe_staged" | sed 's|^apps/frontend/||')
  echo "[pre-commit] biome check --write (fichiers stagés)…"
  (
    cd apps/frontend
    printf '%s\n' "$fe_rel" | tr '\n' '\0' | xargs -0 \
      pnpm exec biome check --write --no-errors-on-unmatched --files-ignore-unknown=true
  )
fi

# --- Re-stage : les formatters ont pu réécrire les fichiers stagés -----------
# On ne re-stage QUE ce qui était déjà stagé ; les modifications non stagées du
# working tree restent en dehors du commit.
printf '%s\n' "$staged" | while IFS= read -r f; do
  if [ -f "$f" ]; then
    git add -- "$f"
  fi
done

echo "[pre-commit] scan des secrets (fichiers indexés)…"
scan_secrets

# --- Tests ciblés sur les fichiers stagés ------------------------------------
echo "[pre-commit] tests liés aux fichiers stagés…"
node scripts/staged-tests.js

exit 0
