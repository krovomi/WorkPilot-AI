# coverage.py settings for the backend suite (pytest --cov, and the combine
# step of the coverage-python job in .github/workflows/ci.yml).
[run]
# The desktop app starts each runner as `python runners/<name>.py`, and the
# tests that matter start it the same way. Measuring those child processes
# counts what they ran instead of leaving every entry point at 0 %.
patch = subprocess
# The server's database calls go through SQLAlchemy's asyncio layer, which
# runs each one in a greenlet. The default trace function loses every line
# after the first `await` on the database (a route's body, a job's end);
# sys.monitoring follows them, and is faster (ci.yml sets it as well). Not
# `concurrency = greenlet`: sys.monitoring does not take it, so coverage
# falls back to the trace function and warns on the stderr of every runner
# the tests start, which the tests read.
core = sysmon
